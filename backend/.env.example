GROQ_API_KEY=your_groq_api_key_here
FAST_MODEL=llama-3.1-8b-instant
FAST_MODEL_PROVIDER=groq
THINKING_MODEL=claude-sonnet-4-6
THINKING_MODEL_PROVIDER=anthropic
ALLOWED_ORIGINS=http://localhost:5173,https://askmypdf.vercel.app
ALLOWED_ORIGIN_REGEX=
CHROMA_PATH=./data/chroma
UPLOAD_DIR=./data/uploads
MAX_FILE_SIZE_MB=50
CHUNK_SIZE=1200
CHUNK_OVERLAP=0
UPLOAD_EMBEDDING_BATCH_SIZE=256
UPLOAD_JOB_TTL_SECONDS=3600
TOP_K_RESULTS=5
MAX_SESSIONS=20
TORCH_NUM_THREADS=2
PORT=8000
